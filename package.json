{
  "name": "playwrightmentoring",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "testAll": "npx playwright test --workers=8",
    "testAll1Thread": "npx playwright test --workers=1",
    "testAllHead": "npx playwright test --headed",
    "testAug31": "npx playwright test testsAug31 --workers=4 --retries=0",
    "testAug31Head": "npx playwright test testsAug31 --workers=1 --retries=0 --headed",
    "version:node": "node -v",
    "version:npm": "npm -v",
    "version:pw": "npx playwright --version",
    "install-latest:node": "nvm install latest",
    "install-latest:node2": "nvm install node --reinstall-packages-from=node",
    "install-latest:npm": "npm install -g npm@latest",
    "install-latest:pw": "npm install -D @playwright/test@latest",
    "install-latest:pwDrivers": "npx playwright install",
    "regen": "npx playwright show-report",
    "gitHistoryRecent": "git log --oneline -n 5",
    "gitHistoryExtended": "git log --pretty=format:\"%h %an %s\" -n 25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erick9025/PlaywrightMentoring.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/erick9025/PlaywrightMentoring/issues"
  },
  "homepage": "https://github.com/erick9025/PlaywrightMentoring#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0"
  }
}
